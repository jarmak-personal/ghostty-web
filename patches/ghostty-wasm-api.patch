+test "retained range terminal statuses release native state immediately" {
+    const term = new(10, 2);
+    defer free(term);
+    try std.testing.expect(term != null);
+
+    var start: [4]u32 = undefined;
+    try std.testing.expectEqual(
+        @as(c_int, 4),
+        captureRetainedBufferBoundary(term, &start, start.len),
+    );
+    write(term, "x", 1);
+    var end: [4]u32 = undefined;
+    try std.testing.expectEqual(
+        @as(c_int, 4),
+        captureRetainedBufferBoundary(term, &end, end.len),
+    );
+
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(term.?));
+    const stale_id = retainedRangeCreate(term, start[0], end[0], false);
+    try std.testing.expect(stale_id != 0);
+    wrapper.retained_ranges.invalidateScreen(&wrapper.terminal, .primary);
+    try std.testing.expectEqual(@as(c_int, -1), retainedRangeStep(term, stale_id));
+    try std.testing.expect(wrapper.retained_ranges.entry == null);
+
+    const large_id = retainedRangeCreate(term, start[0], end[0], false);
+    try std.testing.expect(large_id != 0);
+    const large = &wrapper.retained_ranges.entry.?;
+    try large.output.ensureTotalCapacity(max_retained_range_bytes + 1);
+    large.output.writer.end = max_retained_range_bytes + 1;
+    try std.testing.expectEqual(@as(c_int, -2), retainedRangeStep(term, large_id));
+    try std.testing.expect(wrapper.retained_ranges.entry == null);
+}

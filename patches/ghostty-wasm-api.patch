+test "retained search create releases state when registry insertion fails" {
+    const alloc = std.testing.allocator;
+    var terminal = try Terminal.init(alloc, .{
+        .cols = 10,
+        .rows = 2,
+        .max_scrollback = 8,
+    });
+    defer terminal.deinit(alloc);
+
+    var registry: RetainedSearchRegistry = .{};
+    defer registry.deinit(alloc);
+
+    retained_search_create_tw.errorAlways(.registry_insert, error.OutOfMemory);
+    defer retained_search_create_tw.reset();
+    try std.testing.expectEqual(
+        @as(?u32, null),
+        registry.create(alloc, &terminal, "needle", true),
+    );
+    try retained_search_create_tw.end(.reset);
+}

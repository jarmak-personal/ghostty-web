@@ -0,0 +1,450 @@
+/**
+ * @file terminal.h
+ *
+ * Minimal, high-performance terminal emulator API for WASM.
+ *
+ * The key optimization is the RenderState API which provides a pre-computed
+ * snapshot of all render data in a single update call, avoiding multiple
+ * WASM boundary crossings.
+ *
+ * Basic usage:
+ *   1. Create terminal: ghostty_terminal_new(80, 24)
+ *   2. Write data: ghostty_terminal_write(term, data, len)
+ *   3. Each frame:
+ *      - ghostty_render_state_update(term)
+ *      - ghostty_render_state_get_viewport(term, buffer, size)
+ *      - Render the buffer
+ *      - ghostty_render_state_mark_clean(term)
+ *   4. Free: ghostty_terminal_free(term)
+ */
+
+#ifndef GHOSTTY_VT_TERMINAL_H
+#define GHOSTTY_VT_TERMINAL_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Opaque terminal handle */
+typedef void* GhosttyTerminal;
+
+/**
+ * Terminal configuration. Color values use 0xRRGGBB; color_mask distinguishes
+ * omitted fields from valid black (0x000000).
+ */
+typedef struct {
+    /** Maximum scrollback lines (0 = unlimited) */
+    uint32_t scrollback_limit;
+    /** Bits 0..2 select fg/bg/cursor; bits 8..23 select palette indexes 0..15. */
+    uint32_t color_mask;
+    /** Default foreground color (0xRRGGBB) */
+    uint32_t fg_color;
+    /** Default background color (0xRRGGBB) */
+    uint32_t bg_color;
+    /** Cursor color (0xRRGGBB) */
+    uint32_t cursor_color;
+    /** ANSI color palette (16 colors, 0xRRGGBB format) */
+    uint32_t palette[16];
+    /** Configured cursor style: block, hollow block, bar, or underline. */
+    uint8_t cursor_style;
+    /** Configured blink policy: terminal-controlled, blinking, or steady. */
+    uint8_t cursor_blink;
+    uint16_t _cursor_reserved;
+} GhosttyTerminalConfig;
+
+/** Bounded live color configuration with the same color-mask layout. */
+typedef struct {
+    uint32_t mask;
+    uint32_t fg_color;
+    uint32_t bg_color;
+    uint32_t cursor_color;
+    uint32_t palette[16];
+} GhosttyColorConfig;
+
+/** Cell structure - 16 bytes, pre-resolved colors */
+typedef struct {
+    uint32_t codepoint;
+    uint8_t fg_r, fg_g, fg_b;
+    uint8_t bg_r, bg_g, bg_b;
+    uint8_t flags;
+    uint8_t width;
+    uint16_t hyperlink_id;
+    uint8_t grapheme_len;  /* Number of extra codepoints beyond first (0 = no grapheme) */
+    uint8_t _pad;
+} GhosttyCell;
+
+/** Cell flags */
+#define GHOSTTY_CELL_BOLD          (1 << 0)
+#define GHOSTTY_CELL_ITALIC        (1 << 1)
+#define GHOSTTY_CELL_UNDERLINE     (1 << 2)
+#define GHOSTTY_CELL_STRIKETHROUGH (1 << 3)
+#define GHOSTTY_CELL_INVERSE       (1 << 4)
+#define GHOSTTY_CELL_INVISIBLE     (1 << 5)
+#define GHOSTTY_CELL_BLINK         (1 << 6)
+#define GHOSTTY_CELL_FAINT         (1 << 7)
+
+/** Dirty state */
+typedef enum {
+    GHOSTTY_DIRTY_NONE = 0,
+    GHOSTTY_DIRTY_PARTIAL = 1,
+    GHOSTTY_DIRTY_FULL = 2
+} GhosttyDirty;
+
+/* ============================================================================
+ * Lifecycle
+ * ========================================================================= */
+
+/** Create a new terminal with default settings */
+GhosttyTerminal ghostty_terminal_new(int cols, int rows);
+
+/**
+ * Create a new terminal with custom configuration.
+ * @param cols Number of columns
+ * @param rows Number of rows
+ * @param config Configuration options (NULL = use defaults)
+ * @return Terminal handle, or NULL on failure
+ */
+GhosttyTerminal ghostty_terminal_new_with_config(
+    int cols,
+    int rows,
+    const GhosttyTerminalConfig* config
+);
+
+/** Free a terminal */
+void ghostty_terminal_free(GhosttyTerminal term);
+
+/** Resize terminal */
+void ghostty_terminal_resize(GhosttyTerminal term, int cols, int rows);
+
+/** Change configured base colors while preserving contents and app overrides. */
+bool ghostty_terminal_set_color_config(
+    GhosttyTerminal term,
+    const GhosttyColorConfig* config
+);
+
+/** Update configured cursor defaults without replacing terminal state. */
+bool ghostty_terminal_set_cursor_config(
+    GhosttyTerminal term,
+    uint8_t style,
+    uint8_t blink
+);
+
+/** Write data to terminal (parses VT sequences) */
+void ghostty_terminal_write(GhosttyTerminal term, const uint8_t* data, size_t len);
+
+/* ============================================================================
+ * Retained normal-buffer search
+ * ========================================================================= */
+
+/** Begin a literal search of the retained primary screen. Returns zero on error. */
+uint32_t ghostty_terminal_retained_search_create(
+    GhosttyTerminal term,
+    const uint8_t* query,
+    size_t query_len,
+    bool case_sensitive
+);
+
+/** Perform one bounded search step: 0=pending, 1=complete, -1=error/stale. */
+int ghostty_terminal_retained_search_step(GhosttyTerminal term, uint32_t search_id);
+
+/** Cancel a search and release all native query/result state. */
+void ghostty_terminal_retained_search_cancel(GhosttyTerminal term, uint32_t search_id);
+
+/** Return the completed search match count, or -1 for stale/invalid state. */
+int ghostty_terminal_retained_search_match_count(GhosttyTerminal term, uint32_t search_id);
+
+/**
+ * Resolve one match to four uint32 values: inclusive start row/column and
+ * inclusive end row/column. Returns 4 on success or -1 when stale.
+ */
+int ghostty_terminal_retained_search_match_range(
+    GhosttyTerminal term,
+    uint32_t search_id,
+    uint32_t match_index,
+    uint32_t* out_buffer,
+    size_t buffer_size
+);
+
+/**
+ * Extract exact plain UTF-8 for a live match range. With buffer_size zero,
+ * returns the required byte length. Returns -1 when stale or too small.
+ */
+int ghostty_terminal_retained_search_match_text(
+    GhosttyTerminal term,
+    uint32_t search_id,
+    uint32_t match_index,
+    uint8_t* out_buffer,
+    size_t buffer_size
+);
+
+/** Generation changed by any write that may have affected primary cells. */
+uint32_t ghostty_terminal_get_primary_screen_generation(GhosttyTerminal term);
+
+/** Generation changed by any write that may have affected alternate cells. */
+uint32_t ghostty_terminal_get_alternate_screen_generation(GhosttyTerminal term);
+
+/** Capture id, screen flag, retained row, and column for the active cursor. */
+int ghostty_terminal_capture_retained_buffer_boundary(
+    GhosttyTerminal term,
+    uint32_t* out_buffer,
+    size_t buffer_size
+);
+
+/** Begin exact [start,end) extraction between retained same-screen tokens. */
+uint32_t ghostty_terminal_retained_range_create(
+    GhosttyTerminal term,
+    uint32_t start_id,
+    uint32_t end_id,
+    bool alternate
+);
+
+/** Perform one page-bounded step: 0=pending, 1=complete, -1=stale, -2=too large. */
+int ghostty_terminal_retained_range_step(GhosttyTerminal term, uint32_t range_id);
+
+/** Cancel extraction and release all native pins and transient text. */
+void ghostty_terminal_retained_range_cancel(GhosttyTerminal term, uint32_t range_id);
+
+/** Query/copy the complete all-or-nothing exact UTF-8 extraction result. */
+int ghostty_terminal_retained_range_text(
+    GhosttyTerminal term,
+    uint32_t range_id,
+    uint8_t* out_buffer,
+    size_t buffer_size
+);
+
+/* ============================================================================
+ * Structured terminal events
+ * ========================================================================= */
+
+/**
+ * Return the size of the next versioned event record, or zero when empty.
+ * Records are delivered in parser order and retained bytes are capped at 64 KiB.
+ */
+int ghostty_terminal_peek_event_size(GhosttyTerminal term);
+
+/**
+ * Copy and consume the next event record.
+ * Returns bytes written, zero when empty, or -1 when the buffer is too small.
+ */
+int ghostty_terminal_read_event(
+    GhosttyTerminal term,
+    uint8_t* out_buffer,
+    size_t buffer_size
+);
+
+/**
+ * Resolve semantic provenance to its current retained row.
+ * Returns -1 after eviction, screen removal, reset, or terminal destruction.
+ */
+int ghostty_terminal_resolve_event_provenance(
+    GhosttyTerminal term,
+    uint32_t provenance_id,
+    bool alternate
+);
+
+/** Resolve a semantic provenance token to retained row and column. */
+int ghostty_terminal_resolve_event_boundary(
+    GhosttyTerminal term,
+    uint32_t provenance_id,
+    bool alternate,
+    uint32_t* out_buffer,
+    size_t buffer_size
+);
+
+/* ============================================================================
+ * RenderState API - High-performance rendering
+ * ========================================================================= */
+
+/** Update render state from terminal. Call once per frame. */
+GhosttyDirty ghostty_render_state_update(GhosttyTerminal term);
+
+/** Get dimensions */
+int ghostty_render_state_get_cols(GhosttyTerminal term);
+int ghostty_render_state_get_rows(GhosttyTerminal term);
+
+/** Get cursor state (individual getters for WASM efficiency) */
+int ghostty_render_state_get_cursor_x(GhosttyTerminal term);
+int ghostty_render_state_get_cursor_y(GhosttyTerminal term);
+bool ghostty_render_state_get_cursor_visible(GhosttyTerminal term);
+bool ghostty_render_state_get_cursor_blinking(GhosttyTerminal term);
+uint8_t ghostty_render_state_get_cursor_style(GhosttyTerminal term);
+bool ghostty_render_state_get_cursor_default(GhosttyTerminal term);
+
+/** Get default colors as 0xRRGGBB */
+uint32_t ghostty_render_state_get_bg_color(GhosttyTerminal term);
+uint32_t ghostty_render_state_get_fg_color(GhosttyTerminal term);
+uint32_t ghostty_render_state_get_cursor_color(GhosttyTerminal term);
+uint32_t ghostty_render_state_get_palette_color(GhosttyTerminal term, int index);
+
+/** Check if a row is dirty */
+bool ghostty_render_state_is_row_dirty(GhosttyTerminal term, int y);
+
+/** Mark render state as clean (call after rendering) */
+void ghostty_render_state_mark_clean(GhosttyTerminal term);
+
+/**
+ * Get ALL viewport cells in one call - the key performance optimization!
+ * Buffer must be at least (rows * cols) cells.
+ * Returns total cells written, or -1 on error.
+ */
+int ghostty_render_state_get_viewport(
+    GhosttyTerminal term,
+    GhosttyCell* out_buffer,
+    size_t buffer_size
+);
+
+/**
+ * Get grapheme codepoints for a cell at (row, col).
+ * For cells with grapheme_len > 0, this returns all codepoints that make up
+ * the grapheme cluster. The buffer receives u32 codepoints.
+ * @param row Row index (0-based)
+ * @param col Column index (0-based)
+ * @param out_buffer Buffer to receive codepoints
+ * @param buffer_size Size of buffer in u32 elements
+ * @return Number of codepoints written (including the first), or -1 on error
+ */
+int ghostty_render_state_get_grapheme(
+    GhosttyTerminal term,
+    int row,
+    int col,
+    uint32_t* out_buffer,
+    size_t buffer_size
+);
+
+/* ============================================================================
+ * Terminal Modes
+ * ========================================================================= */
+
+/** Check if alternate screen is active */
+bool ghostty_terminal_is_alternate_screen(GhosttyTerminal term);
+
+/** Check if any mouse tracking mode is enabled */
+bool ghostty_terminal_has_mouse_tracking(GhosttyTerminal term);
+
+/** Return the generation incremented for every synchronized-output enable action. */
+uint32_t ghostty_terminal_get_synchronized_output_generation(GhosttyTerminal term);
+
+/** Clear synchronized-output mode after the native-compatible timeout. */
+void ghostty_terminal_reset_synchronized_output(GhosttyTerminal term);
+
+/**
+ * Query arbitrary terminal mode by number.
+ * @param mode Mode number (e.g., 25 for cursor visibility, 2004 for bracketed paste)
+ * @param is_ansi true for ANSI modes, false for DEC modes
+ * @return true if mode is enabled
+ */
+bool ghostty_terminal_get_mode(GhosttyTerminal term, int mode, bool is_ansi);
+
+/** Get the active Kitty keyboard protocol flags. */
+uint8_t ghostty_terminal_get_kitty_keyboard_flags(GhosttyTerminal term);
+
+/** Check whether xterm modifyOtherKeys mode 2 is active. */
+bool ghostty_terminal_has_modify_other_keys_state_2(GhosttyTerminal term);
+
+/* ============================================================================
+ * Scrollback API
+ * ========================================================================= */
+
+/** Get number of scrollback lines (history, not including active screen) */
+int ghostty_terminal_get_scrollback_length(GhosttyTerminal term);
+
+/**
+ * Get a line from the scrollback buffer.
+ * @param offset 0 = oldest line, (length-1) = most recent scrollback line
+ * @param out_buffer Buffer to write cells to
+ * @param buffer_size Size of buffer in cells (must be >= cols)
+ * @return Number of cells written, or -1 on error
+ */
+int ghostty_terminal_get_scrollback_line(
+    GhosttyTerminal term,
+    int offset,
+    GhosttyCell* out_buffer,
+    size_t buffer_size
+);
+
+/**
+ * Get grapheme codepoints for a cell in the scrollback buffer.
+ * @param offset Scrollback line offset (0 = oldest)
+ * @param col Column index (0-based)
+ * @param out_buffer Buffer to receive codepoints
+ * @param buffer_size Size of buffer in u32 elements
+ * @return Number of codepoints written, or -1 on error
+ */
+int ghostty_terminal_get_scrollback_grapheme(
+    GhosttyTerminal term,
+    int offset,
+    int col,
+    uint32_t* out_buffer,
+    size_t buffer_size
+);
+
+/** Check if a row is a continuation from previous row (soft-wrapped) */
+bool ghostty_terminal_is_row_wrapped(GhosttyTerminal term, int y);
+
+/* ============================================================================
+ * Hyperlink API
+ * ========================================================================= */
+
+/**
+ * Get the hyperlink URI for a cell in the active viewport.
+ * @param row Row index (0-based)
+ * @param col Column index (0-based)
+ * @param out_buffer Buffer to receive URI bytes (UTF-8)
+ * @param buffer_size Size of buffer in bytes
+ * @return Number of bytes written, 0 if no hyperlink, -1 on error
+ */
+int ghostty_terminal_get_hyperlink_uri(
+    GhosttyTerminal term,
+    int row,
+    int col,
+    uint8_t* out_buffer,
+    size_t buffer_size
+);
+
+/**
+ * Get the hyperlink URI for a cell in the scrollback buffer.
+ * @param offset Scrollback line offset (0 = oldest, scrollback_len-1 = newest)
+ * @param col Column index (0-based)
+ * @param out_buffer Buffer to receive URI bytes (UTF-8)
+ * @param buffer_size Size of buffer in bytes
+ * @return Number of bytes written, 0 if no hyperlink, -1 on error
+ */
+int ghostty_terminal_get_scrollback_hyperlink_uri(
+    GhosttyTerminal term,
+    int offset,
+    int col,
+    uint8_t* out_buffer,
+    size_t buffer_size
+);
+
+/* ============================================================================
+ * Response API - for DSR and other terminal queries
+ * ========================================================================= */
+
+/**
+ * Check if there are pending responses from the terminal.
+ * Responses are generated by escape sequences like DSR (Device Status Report).
+ */
+bool ghostty_terminal_has_response(GhosttyTerminal term);
+
+/**
+ * Read pending responses from the terminal.
+ * @param out_buffer Buffer to write response bytes to
+ * @param buffer_size Size of buffer in bytes
+ * @return Number of bytes written, 0 if no responses pending, -1 on error
+ */
+int ghostty_terminal_read_response(
+    GhosttyTerminal term,
+    uint8_t* out_buffer,
+    size_t buffer_size
+);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* GHOSTTY_VT_TERMINAL_H */

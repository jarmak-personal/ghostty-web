+/// Get one effective indexed palette color as 0xRRGGBB.
+pub fn renderStateGetPaletteColor(ptr: ?*anyopaque, index: c_int) callconv(.c) u32 {
+    const wrapper: *const TerminalWrapper = @ptrCast(@alignCast(ptr orelse return 0));
+    if (index < 0) return 0;
+    const palette_index: usize = @intCast(index);
+    if (palette_index >= wrapper.render_state.colors.palette.len) return 0;
+    const palette = wrapper.render_state.colors.palette[palette_index];
+    return (@as(u32, palette.r) << 16) | (@as(u32, palette.g) << 8) | palette.b;
+}

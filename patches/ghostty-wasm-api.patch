+test "configured cursor defaults and application requests share native state" {
+    const config: GhosttyTerminalConfig = .{
+        .scrollback_limit = 10_000,
+        .color_mask = 0,
+        .fg_color = 0,
+        .bg_color = 0,
+        .cursor_color = 0,
+        .palette = .{0} ** 16,
+        .cursor_style = @intFromEnum(CursorStyleConfig.block_hollow),
+        .cursor_blink = @intFromEnum(CursorBlinkConfig.terminal),
+        ._cursor_reserved = 0,
+    };
+    const term = newWithConfig(10, 3, &config);
+    defer free(term);
+    try std.testing.expect(term != null);
+
+    _ = renderStateUpdate(term);
+    try std.testing.expectEqual(
+        @intFromEnum(CursorStyleConfig.block_hollow),
+        renderStateGetCursorStyle(term),
+    );
+    try std.testing.expect(renderStateGetCursorBlinking(term));
+    try std.testing.expect(renderStateGetCursorDefault(term));
+
+    const dec_steady = "\x1b[?12l";
+    write(term, dec_steady, dec_steady.len);
+    _ = renderStateUpdate(term);
+    try std.testing.expect(!renderStateGetCursorBlinking(term));
+
+    renderStateMarkClean(term);
+    const app_block = "\x1b[1 q";
+    write(term, app_block, app_block.len);
+    try std.testing.expectEqual(GhosttyDirty.none, renderStateUpdate(term));
+    try std.testing.expectEqual(
+        @intFromEnum(CursorStyleConfig.block),
+        renderStateGetCursorStyle(term),
+    );
+    try std.testing.expect(renderStateGetCursorBlinking(term));
+    try std.testing.expect(!renderStateGetCursorDefault(term));
+    try std.testing.expect(!renderStateIsRowDirty(term, 0));
+
+    try std.testing.expect(setCursorConfig(
+        term,
+        @intFromEnum(CursorStyleConfig.underline),
+        @intFromEnum(CursorBlinkConfig.steady),
+    ));
+    _ = renderStateUpdate(term);
+    try std.testing.expectEqual(
+        @intFromEnum(CursorStyleConfig.block),
+        renderStateGetCursorStyle(term),
+    );
+
+    const app_reset = "\x1b[0 q";
+    write(term, app_reset, app_reset.len);
+    _ = renderStateUpdate(term);
+    try std.testing.expectEqual(
+        @intFromEnum(CursorStyleConfig.underline),
+        renderStateGetCursorStyle(term),
+    );
+    try std.testing.expect(!renderStateGetCursorBlinking(term));
+    try std.testing.expect(renderStateGetCursorDefault(term));
+    try std.testing.expect(!setCursorConfig(term, 255, 255));
+}
+
+test "configured palette changes preserve overrides and resets use latest base" {
+    const config: GhosttyTerminalConfig = .{
+        .scrollback_limit = 10_000,
+        .color_mask = foreground_configured |
+            background_configured |
+            cursor_configured |
+            (@as(u32, 1) << palette_configured_shift),
+        .fg_color = 0x102030,
+        .bg_color = 0x000000,
+        .cursor_color = 0x405060,
+        .palette = .{0x000000} ++ .{0} ** 15,
+        .cursor_style = @intFromEnum(CursorStyleConfig.block),
+        .cursor_blink = @intFromEnum(CursorBlinkConfig.steady),
+        ._cursor_reserved = 0,
+    };
+    const term = newWithConfig(10, 2, &config);
+    defer free(term);
+    try std.testing.expect(term != null);
+
+    _ = renderStateUpdate(term);
+    try std.testing.expectEqual(@as(u32, 0x102030), renderStateGetFgColor(term));
+    try std.testing.expectEqual(@as(u32, 0x000000), renderStateGetBgColor(term));
+    try std.testing.expectEqual(@as(u32, 0x405060), renderStateGetCursorColor(term));
+    try std.testing.expectEqual(@as(u32, 0x000000), renderStateGetPaletteColor(term, 0));
+
+    const overrides = "\x1b]10;#a1a2a3\x07" ++
+        "\x1b]11;#b1b2b3\x07" ++
+        "\x1b]12;#c1c2c3\x07" ++
+        "\x1b]4;0;#d1d2d3\x07";
+    write(term, overrides, overrides.len);
+    _ = renderStateUpdate(term);
+
+    const next: GhosttyColorConfig = .{
+        .mask = config.color_mask,
+        .fg_color = 0x112233,
+        .bg_color = 0x010203,
+        .cursor_color = 0x445566,
+        .palette = .{0x070809} ++ .{0} ** 15,
+    };
+    try std.testing.expect(setColorConfig(term, &next));
+    _ = renderStateUpdate(term);
+    try std.testing.expectEqual(@as(u32, 0xA1A2A3), renderStateGetFgColor(term));
+    try std.testing.expectEqual(@as(u32, 0xB1B2B3), renderStateGetBgColor(term));
+    try std.testing.expectEqual(@as(u32, 0xC1C2C3), renderStateGetCursorColor(term));
+    try std.testing.expectEqual(@as(u32, 0xD1D2D3), renderStateGetPaletteColor(term, 0));
+
+    const resets = "\x1b]110\x07\x1b]111\x07\x1b]112\x07\x1b]104;0\x07";
+    write(term, resets, resets.len);
+    _ = renderStateUpdate(term);
+    try std.testing.expectEqual(@as(u32, 0x112233), renderStateGetFgColor(term));
+    try std.testing.expectEqual(@as(u32, 0x010203), renderStateGetBgColor(term));
+    try std.testing.expectEqual(@as(u32, 0x445566), renderStateGetCursorColor(term));
+    try std.testing.expectEqual(@as(u32, 0x070809), renderStateGetPaletteColor(term, 0));
+}

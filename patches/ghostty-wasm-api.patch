+// ============================================================================
+// Retained semantic-boundary extraction API
+// ============================================================================
+
+/// Capture the active cursor as id, screen flag, retained row, and column.
+pub fn captureRetainedBufferBoundary(
+    ptr: ?*anyopaque,
+    out: [*]u32,
+    out_len: usize,
+) callconv(.c) c_int {
+    if (out_len < 4) return -1;
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return -1));
+    const boundary = wrapper.provenance.register(&wrapper.terminal) orelse return -1;
+    out[0] = boundary.id;
+    out[1] = if (boundary.screen == .alternate) 1 else 0;
+    out[2] = boundary.row;
+    out[3] = boundary.column;
+    return 4;
+}
+
+/// Create a same-screen [start,end) extraction from authenticated native ids.
+pub fn retainedRangeCreate(
+    ptr: ?*anyopaque,
+    start_id: u32,
+    end_id: u32,
+    alternate: bool,
+) callconv(.c) u32 {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return 0));
+    const screen: ScreenSet.Key = if (alternate) .alternate else .primary;
+    return wrapper.retained_ranges.create(
+        wrapper.alloc,
+        &wrapper.terminal,
+        &wrapper.provenance,
+        start_id,
+        end_id,
+        screen,
+    ) orelse 0;
+}
+
+pub fn retainedRangeStep(ptr: ?*anyopaque, range_id: u32) callconv(.c) c_int {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return -1));
+    const result = wrapper.retained_ranges.step(&wrapper.terminal, range_id);
+    if (result < 0) wrapper.retained_ranges.remove(&wrapper.terminal, range_id);
+    return result;
+}
+
+pub fn retainedRangeCancel(ptr: ?*anyopaque, range_id: u32) callconv(.c) void {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return));
+    wrapper.retained_ranges.remove(&wrapper.terminal, range_id);
+}
+
+/// Return required bytes when out_len is zero, otherwise copy the complete
+/// all-or-nothing UTF-8 result.
+pub fn retainedRangeText(
+    ptr: ?*anyopaque,
+    range_id: u32,
+    out: ?[*]u8,
+    out_len: usize,
+) callconv(.c) c_int {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return -1));
+    const value = wrapper.retained_ranges.text(range_id) orelse return -1;
+    const len = std.math.cast(c_int, value.len) orelse return -1;
+    if (out_len == 0) return len;
+    const dest = out orelse return -1;
+    if (out_len < value.len) return -1;
+    @memcpy(dest[0..value.len], value);
+    return len;
+}

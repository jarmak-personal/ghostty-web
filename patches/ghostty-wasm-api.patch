+    fn create(
+        self: *RetainedRangeRegistry,
+        alloc: Allocator,
+        terminal: *Terminal,
+        provenance: *const ProvenanceRegistry,
+        start_id: u32,
+        end_id: u32,
+        screen_key: ScreenSet.Key,
+    ) ?u32 {
+        const start_source = provenance.resolvePin(terminal, start_id, screen_key) orelse return null;
+        const end_source = provenance.resolvePin(terminal, end_id, screen_key) orelse return null;
+        const empty = boundaryEql(start_source, end_source);
+        // Do not use Pin.before across nodes here: creation must stay O(1).
+        // Cross-page ordering is discovered one next pointer per step below.
+        if (start_source.pin.node == end_source.pin.node and
+            !empty and
+            !boundaryBefore(start_source, end_source)) return null;
+
+        const screen = terminal.screens.get(screen_key) orelse return null;
+        const start = screen.pages.trackPin(start_source.pin.*) catch return null;
+        const end = screen.pages.trackPin(end_source.pin.*) catch {
+            screen.pages.untrackPin(start);
+            return null;
+        };
+        const format_start = if (start_source.after_cell and !empty) format_start: {
+            var next = start.down(1) orelse {
+                screen.pages.untrackPin(start);
+                screen.pages.untrackPin(end);
+                return null;
+            };
+            next.x = 0;
+            break :format_start next;
+        } else start.*;
+
+        const id = self.next_id;
+        self.next_id = id +% 1;
+        if (self.next_id == 0) self.next_id = 1;
+
+        const entry: Entry = .{
+            .id = id,
+            .screen = screen_key,
+            .start = start,
+            .end = end,
+            .start_row = start.rowAndCell().row,
+            .end_row = end.rowAndCell().row,
+            .start_serial = start.node.serial,
+            .end_serial = end.node.serial,
+            .start_after_cell = start_source.after_cell,
+            .end_after_cell = end_source.after_cell,
+            .format_start = format_start,
+            .format_start_serial = format_start.node.serial,
+            .next_node = format_start.node,
+            .next_serial = format_start.node.serial,
+            .output = .init(alloc),
+            .prefix_newline = start_source.after_cell and
+                !empty and
+                !start.rowAndCell().row.wrap,
+            .no_cells = !empty and
+                !end_source.after_cell and
+                format_start.eql(end.*),
+        };
+        self.clear(terminal);
+        self.entry = entry;
+        return id;
+    }
+
+    fn boundaryEql(a: ProvenanceRegistry.Entry, b: ProvenanceRegistry.Entry) bool {
+        return a.pin.eql(b.pin.*) and a.after_cell == b.after_cell;
+    }
+
+    fn boundaryBefore(a: ProvenanceRegistry.Entry, b: ProvenanceRegistry.Entry) bool {
+        if (a.pin.node != b.pin.node) return false;
+        if (a.pin.y < b.pin.y) return true;
+        if (a.pin.y > b.pin.y) return false;
+        const a_x: usize = @as(usize, a.pin.x) + @intFromBool(a.after_cell);
+        const b_x: usize = @as(usize, b.pin.x) + @intFromBool(b.after_cell);
+        return a_x < b_x;
+    }
+
+    fn remove(self: *RetainedRangeRegistry, terminal: *Terminal, id: u32) void {
+        const entry = if (self.entry) |*entry| entry else return;
+        if (entry.id != id) return;
+        entry.deinit(terminal);
+        self.entry = null;
+    }
+
+    fn validatedEnd(self: *const RetainedRangeRegistry, terminal: *const Terminal, entry: *const Entry) ?PageList.Pin {
+        _ = self;
+        if (!entry.active or entry.start.garbage or entry.end.garbage) return null;
+        _ = terminal.screens.get(entry.screen) orelse return null;
+        if (entry.start.node.serial != entry.start_serial or
+            entry.end.node.serial != entry.end_serial or
+            entry.format_start.node.serial != entry.format_start_serial or
+            entry.start.y >= entry.start.node.data.size.rows or
+            entry.end.y >= entry.end.node.data.size.rows or
+            entry.start.x >= entry.start.node.data.size.cols or
+            entry.end.x >= entry.end.node.data.size.cols) return null;
+        if (entry.start.rowAndCell().row != entry.start_row or entry.end.rowAndCell().row != entry.end_row) return null;
+        if (entry.start.eql(entry.end.*) and
+            entry.start_after_cell == entry.end_after_cell) return entry.end.*;
+
+        if (entry.end_after_cell) return entry.end.*;
+        if (entry.end.x > 0) return entry.end.left(1);
+        var previous = entry.end.up(1) orelse return null;
+        previous.x = previous.node.data.size.cols - 1;
+        return previous;
+    }
+
+    /// Return 0 while pending, 1 on completion, -1 when stale, and -2 when
+    /// exact text exceeds the fixed public result ceiling.
+    fn step(self: *RetainedRangeRegistry, terminal: *Terminal, id: u32) c_int {
+        const entry = if (self.entry) |*entry| entry else return -1;
+        if (entry.id != id) return -1;
+        const end_inclusive = self.validatedEnd(terminal, entry) orelse return -1;
+        if (entry.complete) return 1;
+        if (entry.start.eql(entry.end.*) and
+            entry.start_after_cell == entry.end_after_cell)
+        {
+            entry.complete = true;
+            return 1;
+        }
+
+        if (entry.prefix_newline) {
+            entry.output.writer.writeByte('\n') catch return -1;
+            entry.prefix_newline = false;
+        }
+        if (entry.no_cells) {
+            entry.complete = true;
+            entry.next_node = null;
+            return 1;
+        }
+
+        const node = entry.next_node orelse return -1;
+        if (node.serial != entry.next_serial) return -1;
+        const formatter = PageFormatter.initRange(
+            &node.data,
+            .{ .emit = .plain, .unwrap = true, .trim = false },
+            if (node == entry.format_start.node) entry.format_start.x else 0,
+            if (node == entry.format_start.node) entry.format_start.y else 0,
+            if (node == end_inclusive.node) end_inclusive.x else null,
+            if (node == end_inclusive.node) end_inclusive.y else null,
+            entry.trailing_state,
+        );
+        entry.trailing_state = formatter.formatWithState(&entry.output.writer) catch return -1;
+        if (entry.output.written().len > max_retained_range_bytes) return -2;
+
+        if (node != end_inclusive.node) {
+            entry.next_node = node.next orelse return -1;
+            entry.next_serial = entry.next_node.?.serial;
+            return 0;
+        }
+
+        // PageFormatter intentionally withholds trailing blank rows. Flush
+        // only separators inside [start,end): all of them when the exclusive
+        // boundary is at column zero, otherwise exclude the final row's own
+        // separator. Soft wraps contribute no trailing row here.
+        const rows = if (entry.trailing_state) |state| state.rows else 0;
+        const newline_count = if (!entry.end_after_cell and entry.end.x == 0) rows else rows -| 1;
+        if (entry.output.written().len + newline_count > max_retained_range_bytes) return -2;
+        entry.output.writer.splatByteAll('\n', newline_count) catch return -1;
+        entry.complete = true;
+        entry.next_node = null;
+        return 1;
+    }
+
+    fn text(self: *RetainedRangeRegistry, id: u32) ?[]const u8 {
+        const entry = if (self.entry) |*entry| entry else return null;
+        if (entry.id != id) return null;
+        if (!entry.active or !entry.complete) return null;
+        return entry.output.written();
+    }
+};
+
+/// Search sessions retain Ghostty's cell-aware match metadata, never terminal
+/// text. Page serials make range resolution fail closed after page reuse,
+/// eviction, or reset.
+const retained_search_create_tw = tripwire.module(enum {
+    registry_insert,
+}, Allocator.Error);
+
+const RetainedSearchRegistry = struct {
+    const Entry = struct {
+        search: ScreenSearch,
+        phase: enum { search, index, complete } = .search,
+        index_node: ?*PageList.List.Node = null,
+        index_row: u32 = 0,
+        node_rows: std.AutoHashMapUnmanaged(*PageList.List.Node, NodeRows) = .empty,
+
+        fn deinit(self: *Entry, alloc: Allocator) void {
+            self.search.deinit();
+            self.node_rows.deinit(alloc);
+        }
+    };
+
+    const NodeRows = struct {
+        serial: u64,
+        row: u32,
+    };
+
+    entries: std.AutoHashMapUnmanaged(u32, Entry) = .empty,
+    next_id: u32 = 1,
+
+    fn deinit(self: *RetainedSearchRegistry, alloc: Allocator) void {
+        var it = self.entries.valueIterator();
+        while (it.next()) |entry| entry.deinit(alloc);
+        self.entries.deinit(alloc);
+        self.* = .{};
+    }
+
+    fn clear(self: *RetainedSearchRegistry, alloc: Allocator) void {
+        var it = self.entries.valueIterator();
+        while (it.next()) |entry| entry.deinit(alloc);
+        self.entries.clearRetainingCapacity();
+    }
+
+    fn create(
+        self: *RetainedSearchRegistry,
+        alloc: Allocator,
+        terminal: *Terminal,
+        query: []const u8,
+        case_sensitive: bool,
+    ) ?u32 {
+        if (query.len == 0 or query.len > max_search_query_bytes) return null;
+        const primary = terminal.screens.get(.primary) orelse return null;
+        var search = ScreenSearch.initWithCaseSensitivity(
+            alloc,
+            primary,
+            query,
+            if (case_sensitive) .sensitive else .ascii_insensitive,
+        ) catch return null;
+
+        var id = self.next_id;
+        while (id == 0 or self.entries.contains(id)) id +%= 1;
+        self.next_id = id +% 1;
+        if (self.next_id == 0) self.next_id = 1;
+        const inserted = inserted: {
+            retained_search_create_tw.check(.registry_insert) catch break :inserted false;
+            self.entries.put(alloc, id, .{ .search = search }) catch break :inserted false;
+            break :inserted true;
+        };
+        if (!inserted) {
+            search.deinit();
+            return null;
+        }
+        return id;
+    }
+
+    fn remove(self: *RetainedSearchRegistry, alloc: Allocator, id: u32) void {
+        if (self.entries.fetchRemove(id)) |removed| {
+            var entry = removed.value;
+            entry.deinit(alloc);
+        }
+    }
+
+    /// One call performs at most one core tick, one page feed, or indexes one
+    /// retained page for constant-time range materialization.
+    fn step(self: *RetainedSearchRegistry, alloc: Allocator, id: u32) c_int {
+        const entry = self.entries.getPtr(id) orelse return -1;
+        switch (entry.phase) {
+            .search => entry.search.tick() catch |err| switch (err) {
+                error.FeedRequired => {
+                    entry.search.feed() catch return -1;
+                    return 0;
+                },
+                error.SearchComplete => {
+                    entry.phase = .index;
+                    entry.index_node = entry.search.screen.pages.pages.first;
+                    return 0;
+                },
+                error.OutOfMemory => return -1,
+            },
+            .index => {
+                const node = entry.index_node orelse {
+                    entry.phase = .complete;
+                    return 1;
+                };
+                entry.node_rows.put(alloc, node, .{
+                    .serial = node.serial,
+                    .row = entry.index_row,
+                }) catch return -1;
+                entry.index_row = std.math.add(
+                    u32,
+                    entry.index_row,
+                    node.data.size.rows,
+                ) catch return -1;
+                entry.index_node = node.next;
+                return 0;
+            },
+            .complete => return 1,
+        }
+        return 0;
+    }
+
+    fn matchCount(self: *const RetainedSearchRegistry, id: u32) ?usize {
+        const entry = self.entries.getPtr(id) orelse return null;
+        if (entry.phase != .complete) return null;
+        return entry.search.matchesLen();
+    }
+
+    fn matchAt(self: *const RetainedSearchRegistry, id: u32, index: usize) ?*const @import("../highlight.zig").Flattened {
+        const entry = self.entries.getPtr(id) orelse return null;
+        if (entry.phase != .complete) return null;
+        const history = entry.search.history_results.items;
+        if (index < history.len) return &history[history.len - index - 1];
+        const active_index = index - history.len;
+        const active = entry.search.active_results.items;
+        if (active_index >= active.len) return null;
+        return &active[active_index];
+    }
+
+    fn validatedPins(
+        self: *const RetainedSearchRegistry,
+        id: u32,
+        index: usize,
+    ) ?struct {
+        screen: *@import("../Screen.zig"),
+        start: PageList.Pin,
+        end: PageList.Pin,
+        start_row: u32,
+        end_row: u32,
+    } {
+        const entry = self.entries.getPtr(id) orelse return null;
+        const highlight = self.matchAt(id, index) orelse return null;
+        const chunks = highlight.chunks.slice();
+        if (chunks.len == 0) return null;
+
+        const nodes = chunks.items(.node);
+        const serials = chunks.items(.serial);
+        const starts = chunks.items(.start);
+        const ends = chunks.items(.end);
+        for (nodes, serials, starts, ends) |node, serial, start, end| {
+            const indexed = entry.node_rows.get(node) orelse return null;
+            if (indexed.serial != serial or start >= end or end > node.data.size.rows) return null;
+        }
+
+        const start = highlight.startPin();
+        const end = highlight.endPin();
+        if (start.x >= start.node.data.size.cols or end.x >= end.node.data.size.cols) return null;
+        const start_page = entry.node_rows.get(start.node) orelse return null;
+        const end_page = entry.node_rows.get(end.node) orelse return null;
+        return .{
+            .screen = entry.search.screen,
+            .start = start,
+            .end = end,
+            .start_row = std.math.add(u32, start_page.row, start.y) catch return null,
+            .end_row = std.math.add(u32, end_page.row, end.y) catch return null,
+        };
+    }
+};
+
+/// Response handler that processes VT sequences and queues responses.
+/// This extends the readonly stream handler to also handle queries.
+const ResponseHandler = struct {
+    alloc: Allocator,
+    terminal: *Terminal,
+    response_buffer: *std.ArrayList(u8),
+    events: *EventQueue,
+    provenance: *ProvenanceRegistry,
+    retained_ranges: *RetainedRangeRegistry,
+    cursor_defaults: *CursorDefaults,
+    synchronized_output_generation: *u32,
+    write_screen_mask: *u8,
+
+    pub fn init(
+        alloc: Allocator,
+        terminal: *Terminal,
+        response_buffer: *std.ArrayList(u8),
+        events: *EventQueue,
+        provenance: *ProvenanceRegistry,
+        retained_ranges: *RetainedRangeRegistry,
+        cursor_defaults: *CursorDefaults,
+        synchronized_output_generation: *u32,
+        write_screen_mask: *u8,
+    ) ResponseHandler {
+        return .{
+            .alloc = alloc,
+            .terminal = terminal,
+            .response_buffer = response_buffer,
+            .events = events,
+            .provenance = provenance,
+            .retained_ranges = retained_ranges,
+            .cursor_defaults = cursor_defaults,
+            .synchronized_output_generation = synchronized_output_generation,
+            .write_screen_mask = write_screen_mask,
+        };
+    }
+
+    pub fn deinit(self: *ResponseHandler) void {
+        _ = self;
+    }
+
+    noinline fn noteActiveScreen(self: *ResponseHandler) void {
+        self.write_screen_mask.* |= if (self.terminal.screens.active_key == .primary)
+            primary_screen_touched
+        else
+            alternate_screen_touched;
+    }
+
+    pub fn vt(
+        self: *ResponseHandler,
+        comptime action: Action.Tag,
+        value: Action.Value(action),
+    ) !void {
+        switch (action) {
+            // Device status reports - these need responses
+            .device_status => try self.handleDeviceStatus(value.request),
+            .device_attributes => try self.handleDeviceAttributes(value),
+
+            // All the terminal state modifications (same as stream_readonly.zig)
+            .print => try self.terminal.print(value.cp),
+            .print_repeat => try self.terminal.printRepeat(value),
+            .backspace => self.terminal.backspace(),
+            .carriage_return => self.terminal.carriageReturn(),
+            .linefeed => try self.terminal.linefeed(),
+            .index => try self.terminal.index(),
+            .next_line => {
+                try self.terminal.index();
+                self.terminal.carriageReturn();
+            },
+            .reverse_index => self.terminal.reverseIndex(),
+            .cursor_up => self.terminal.cursorUp(value.value),
+            .cursor_down => self.terminal.cursorDown(value.value),
+            .cursor_left => self.terminal.cursorLeft(value.value),
+            .cursor_right => self.terminal.cursorRight(value.value),
+            .cursor_pos => self.terminal.setCursorPos(value.row, value.col),
+            .cursor_col => self.terminal.setCursorPos(self.terminal.screens.active.cursor.y + 1, value.value),
+            .cursor_row => self.terminal.setCursorPos(value.value, self.terminal.screens.active.cursor.x + 1),
+            .cursor_col_relative => self.terminal.setCursorPos(
+                self.terminal.screens.active.cursor.y + 1,
+                self.terminal.screens.active.cursor.x + 1 +| value.value,
+            ),
+            .cursor_row_relative => self.terminal.setCursorPos(
+                self.terminal.screens.active.cursor.y + 1 +| value.value,
+                self.terminal.screens.active.cursor.x + 1,
+            ),
+            .cursor_style => {
+                switch (value) {
+                    .default => self.cursor_defaults.reset(self.terminal),
+                    .blinking_block => self.cursor_defaults.setApplication(self.terminal, .block, true),
+                    .steady_block => self.cursor_defaults.setApplication(self.terminal, .block, false),
+                    .blinking_bar => self.cursor_defaults.setApplication(self.terminal, .bar, true),
+                    .steady_bar => self.cursor_defaults.setApplication(self.terminal, .bar, false),
+                    .blinking_underline => self.cursor_defaults.setApplication(self.terminal, .underline, true),
+                    .steady_underline => self.cursor_defaults.setApplication(self.terminal, .underline, false),
+                }
+            },
+            .erase_display_below => self.terminal.eraseDisplay(.below, value),
+            .erase_display_above => self.terminal.eraseDisplay(.above, value),
+            .erase_display_complete => self.terminal.eraseDisplay(.complete, value),
+            .erase_display_scrollback => self.terminal.eraseDisplay(.scrollback, value),
+            .erase_display_scroll_complete => self.terminal.eraseDisplay(.scroll_complete, value),
+            .erase_line_right => self.terminal.eraseLine(.right, value),
+            .erase_line_left => self.terminal.eraseLine(.left, value),
+            .erase_line_complete => self.terminal.eraseLine(.complete, value),
+            .erase_line_right_unless_pending_wrap => self.terminal.eraseLine(.right_unless_pending_wrap, value),
+            .delete_chars => self.terminal.deleteChars(value),
+            .erase_chars => self.terminal.eraseChars(value),
+            .insert_lines => self.terminal.insertLines(value),
+            .insert_blanks => self.terminal.insertBlanks(value),
+            .delete_lines => self.terminal.deleteLines(value),
+            .scroll_up => try self.terminal.scrollUp(value),
+            .scroll_down => self.terminal.scrollDown(value),
+            .horizontal_tab => self.horizontalTab(value),
+            .horizontal_tab_back => self.horizontalTabBack(value),
+            .tab_clear_current => self.terminal.tabClear(.current),
+            .tab_clear_all => self.terminal.tabClear(.all),
+            .tab_set => self.terminal.tabSet(),
+            .tab_reset => self.terminal.tabReset(),
+            .set_mode => try self.setMode(value.mode, true),
+            .reset_mode => try self.setMode(value.mode, false),
+            .save_mode => self.terminal.modes.save(value.mode),
+            .restore_mode => {
+                const v = self.terminal.modes.restore(value.mode);
+                try self.setMode(value.mode, v);
+            },
+            .top_and_bottom_margin => self.terminal.setTopAndBottomMargin(value.top_left, value.bottom_right),
+            .left_and_right_margin => self.terminal.setLeftAndRightMargin(value.top_left, value.bottom_right),
+            .left_and_right_margin_ambiguous => {
+                if (self.terminal.modes.get(.enable_left_and_right_margin)) {
+                    self.terminal.setLeftAndRightMargin(0, 0);
+                } else {
+                    self.terminal.saveCursor();
+                }
+            },
+            .save_cursor => self.terminal.saveCursor(),
+            .restore_cursor => self.terminal.restoreCursor(),
+            .invoke_charset => self.terminal.invokeCharset(value.bank, value.charset, value.locking),
+            .configure_charset => self.terminal.configureCharset(value.slot, value.charset),
+            .set_attribute => switch (value) {
+                .unknown => {},
+                else => self.terminal.setAttribute(value) catch {},
+            },
+            .protected_mode_off => self.terminal.setProtectedMode(.off),
+            .protected_mode_iso => self.terminal.setProtectedMode(.iso),
+            .protected_mode_dec => self.terminal.setProtectedMode(.dec),
+            .mouse_shift_capture => self.terminal.flags.mouse_shift_capture = if (value) .true else .false,
+            .kitty_keyboard_push => self.terminal.screens.active.kitty_keyboard.push(value.flags),
+            .kitty_keyboard_pop => self.terminal.screens.active.kitty_keyboard.pop(@intCast(value)),
+            .kitty_keyboard_set => self.terminal.screens.active.kitty_keyboard.set(.set, value.flags),
+            .kitty_keyboard_set_or => self.terminal.screens.active.kitty_keyboard.set(.@"or", value.flags),
+            .kitty_keyboard_set_not => self.terminal.screens.active.kitty_keyboard.set(.not, value.flags),
+            .modify_key_format => {
+                self.terminal.flags.modify_other_keys_2 = false;
+                switch (value) {
+                    .other_keys_numeric => self.terminal.flags.modify_other_keys_2 = true,
+                    else => {},
+                }
+            },
+            .active_status_display => self.terminal.status_display = value,
+            .decaln => try self.terminal.decaln(),
+            .full_reset => {
+                self.events.clearRetainingCapacity();
+                self.retained_ranges.clear(self.terminal);
+                self.provenance.clear(self.terminal);
+                self.terminal.fullReset();
+                self.cursor_defaults.reset(self.terminal);
+                self.noteActiveScreen();
+            },
+            .start_hyperlink => try self.terminal.screens.active.startHyperlink(value.uri, value.id),
+            .end_hyperlink => self.terminal.screens.active.endHyperlink(),
+            .semantic_prompt => {
+                try self.terminal.semanticPrompt(value);
+                self.queueSemantic(value);
+            },
+            .mouse_shape => self.terminal.mouse_shape = value,
+            .color_operation => {
+                try self.colorOperation(value.op, &value.requests);
+                self.queueColorOperation(value.op, &value.requests);
+            },
+            .kitty_color_report => try self.kittyColorOperation(value),
+            .kitty_keyboard_query => try self.queryKittyKeyboard(),
+
+            // Structured, host-owned terminal events.
+            .bell => self.events.append(self.alloc, .{ .tag = .bell }, "", ""),
+            .window_title => self.events.append(self.alloc, .{ .tag = .title }, value.title, ""),
+            .report_pwd => self.events.append(self.alloc, .{ .tag = .working_directory }, value.url, ""),
+            .show_desktop_notification => self.events.append(
+                self.alloc,
+                .{
+                    .tag = .notification,
+                    .action = @intCast(@intFromEnum(value.source)),
+                },
+                value.title,
+                value.body,
+            ),
+            .progress_report => self.events.append(self.alloc, .{
+                .tag = .progress,
+                .action = @intCast(@intFromEnum(value.state)),
+                .value = if (value.progress) |progress| progress else -1,
+            }, "", ""),
+            .clipboard_contents => self.events.append(self.alloc, .{
+                .tag = .clipboard,
+                .action = if (std.mem.eql(u8, value.data, "?")) 0 else 1,
+                .value = value.kind,
+            }, if (std.mem.eql(u8, value.data, "?")) "" else value.data, ""),
+
+            // Actions that require no response and have no terminal effect
+            .dcs_hook,
+            .dcs_put,
+            .dcs_unhook,
+            .apc_start,
+            .apc_end,
+            .apc_put,
+            .enquiry,
+            .request_mode,
+            .request_mode_unknown,
+            .size_report,
+            .xtversion,
+            .title_push,
+            .title_pop,
+            => {},
+        }
+    }
+
+    fn handleDeviceStatus(self: *ResponseHandler, req: device_status.Request) !void {
+        switch (req) {
+            .operating_status => {
+                // DSR 5 - Operating status report: always report "OK"
+                try self.response_buffer.appendSlice(self.alloc, "\x1B[0n");
+            },
+            .cursor_position => {
+                // DSR 6 - Cursor position report (CPR)
+                const cursor = self.terminal.screens.active.cursor;
+                const x = if (self.terminal.modes.get(.origin))
+                    cursor.x -| self.terminal.scrolling_region.left
+                else
+                    cursor.x;
+                const y = if (self.terminal.modes.get(.origin))
+                    cursor.y -| self.terminal.scrolling_region.top
+                else
+                    cursor.y;
+                var buf: [32]u8 = undefined;
+                const resp = std.fmt.bufPrint(&buf, "\x1B[{};{}R", .{
+                    y + 1,
+                    x + 1,
+                }) catch return;
+                try self.response_buffer.appendSlice(self.alloc, resp);
+            },
+            .color_scheme => {
+                // Not supported in WASM context
+            },
+        }
+    }
+
+    fn queryKittyKeyboard(self: *ResponseHandler) !void {
+        var buf: [16]u8 = undefined;
+        const response = try std.fmt.bufPrint(&buf, "\x1B[?{}u", .{
+            self.terminal.screens.active.kitty_keyboard.current().int(),
+        });
+        try self.response_buffer.appendSlice(self.alloc, response);
+    }
+
+    fn handleDeviceAttributes(self: *ResponseHandler, req: ansi.DeviceAttributeReq) !void {
+        // Match main Ghostty behavior for device attribute responses
+        switch (req) {
+            .primary => {
+                // DA1 - Primary Device Attributes
+                // Report as VT220 with color support (simplified for WASM)
+                // 62 = Level 2 conformance, 22 = Color text
+                try self.response_buffer.appendSlice(self.alloc, "\x1B[?62;22c");
+            },
+            .secondary => {
+                // DA2 - Secondary Device Attributes
+                // Report firmware version 1.10.0 (matching main Ghostty)
+                try self.response_buffer.appendSlice(self.alloc, "\x1B[>1;10;0c");
+            },
+            else => {
+                // DA3 and other requests - not implemented in WASM context
+            },
+        }
+    }
+
+    inline fn horizontalTab(self: *ResponseHandler, count: u16) void {
+        for (0..count) |_| {
+            const x = self.terminal.screens.active.cursor.x;
+            self.terminal.horizontalTab();
+            if (x == self.terminal.screens.active.cursor.x) break;
+        }
+    }
+
+    inline fn horizontalTabBack(self: *ResponseHandler, count: u16) void {
+        for (0..count) |_| {
+            const x = self.terminal.screens.active.cursor.x;
+            self.terminal.horizontalTabBack();
+            if (x == self.terminal.screens.active.cursor.x) break;
+        }
+    }
+
+    fn setMode(self: *ResponseHandler, mode: modespkg.Mode, enabled: bool) !void {
+        if (mode == .cursor_blinking and
+            (!self.cursor_defaults.active or self.cursor_defaults.blink != .terminal)) return;
+        self.terminal.modes.set(mode, enabled);
+        switch (mode) {
+            .synchronized_output => if (enabled) {
+                self.synchronized_output_generation.* +%= 1;
+                if (self.synchronized_output_generation.* == 0) {
+                    self.synchronized_output_generation.* = 1;
+                }
+            },
+            .autorepeat, .reverse_colors => {},
+            .origin => self.terminal.setCursorPos(1, 1),
+            .enable_left_and_right_margin => if (!enabled) {
+                self.terminal.scrolling_region.left = 0;
+                self.terminal.scrolling_region.right = self.terminal.cols - 1;
+            },
+            .alt_screen_legacy => {
+                try self.terminal.switchScreenMode(.@"47", enabled);
+                self.noteActiveScreen();
+            },
+            .alt_screen => {
+                try self.terminal.switchScreenMode(.@"1047", enabled);
+                self.noteActiveScreen();
+            },
+            .alt_screen_save_cursor_clear_enter => {
+                try self.terminal.switchScreenMode(.@"1049", enabled);
+                self.noteActiveScreen();
+            },
+            .save_cursor => if (enabled) {
+                self.terminal.saveCursor();
+            } else {
+                self.terminal.restoreCursor();
+            },
+            .enable_mode_3 => {},
+            .@"132_column" => try self.terminal.deccolm(
+                self.terminal.screens.active.alloc,
+                if (enabled) .@"132_cols" else .@"80_cols",
+            ),
+            else => {},
+        }
+    }
+
+    fn queueSemantic(self: *ResponseHandler, command: Action.SemanticPrompt) void {
+        const provenance = self.provenance.register(self.terminal) orelse return;
+        self.events.append(self.alloc, .{
+            .tag = .semantic,
+            .action = @intCast(@intFromEnum(command.action)),
+            .flags = if (self.terminal.screens.active_key == .alternate) 1 else 0,
+            .row = provenance.row,
+            .provenance_id = provenance.id,
+            .reserved = provenance.column,
+        }, command.options_unvalidated, "");
+    }
+
+    fn queueColorOperation(
+        self: *ResponseHandler,
+        op: osc_color.Operation,
+        requests: *const osc_color.List,
+    ) void {
+        var it = requests.constIterator(0);
+        while (it.next()) |request| {
+            var header: EventHeader = .{
+                .tag = .palette,
+                .value = colorOperationNumber(op),
+            };
+            switch (request.*) {
+                .set => |set| {
+                    header.action = 0;
+                    setColorTarget(&header, set.target);
+                    header.color_value = (@as(u32, set.color.r) << 16) |
+                        (@as(u32, set.color.g) << 8) |
+                        set.color.b;
+                },
+                .query => |target| {
+                    header.action = 1;
+                    setColorTarget(&header, target);
+                },
+                .reset => |target| {
+                    header.action = 2;
+                    setColorTarget(&header, target);
+                },
+                .reset_palette => header.action = 3,
+                .reset_special => header.action = 4,
+            }
+            self.events.append(self.alloc, header, "", "");
+        }
+    }
+
+    fn setColorTarget(header: *EventHeader, target: osc_color.Target) void {
+        switch (target) {
+            .palette => |index| {
+                header.flags = 1;
+                header.target = index;
+            },
+            .special => |special| {
+                header.flags = 2;
+                header.target = @intFromEnum(special);
+            },
+            .dynamic => |dynamic| {
+                header.flags = 3;
+                header.target = @intFromEnum(dynamic);
+            },
+        }
+    }
+
+    fn colorOperationNumber(op: osc_color.Operation) i32 {
+        return switch (op) {
+            .osc_4 => 4,
+            .osc_5 => 5,
+            .osc_10 => 10,
+            .osc_11 => 11,
+            .osc_12 => 12,
+            .osc_13 => 13,
+            .osc_14 => 14,
+            .osc_15 => 15,
+            .osc_16 => 16,
+            .osc_17 => 17,
+            .osc_18 => 18,
+            .osc_19 => 19,
+            .osc_104 => 104,
+            .osc_105 => 105,
+            .osc_110 => 110,
+            .osc_111 => 111,
+            .osc_112 => 112,
+            .osc_113 => 113,
+            .osc_114 => 114,
+            .osc_115 => 115,
+            .osc_116 => 116,
+            .osc_117 => 117,
+            .osc_118 => 118,
+            .osc_119 => 119,
+        };
+    }
+
+    fn colorOperation(self: *ResponseHandler, op: anytype, requests: anytype) !void {
+        _ = op;
+        var it = requests.constIterator(0);
+        while (it.next()) |request| {
+            switch (request.*) {
+                .set => |set| switch (set.target) {
+                    .palette => |index| self.terminal.colors.palette.set(index, set.color),
+                    .dynamic => |dynamic| switch (dynamic) {
+                        .foreground => self.terminal.colors.foreground.set(set.color),
+                        .background => self.terminal.colors.background.set(set.color),
+                        .cursor => self.terminal.colors.cursor.set(set.color),
+                        else => continue,
+                    },
+                    .special => continue,
+                },
+                .reset => |target| switch (target) {
+                    .palette => |index| self.terminal.colors.palette.reset(index),
+                    .dynamic => |dynamic| switch (dynamic) {
+                        .foreground => self.terminal.colors.foreground.reset(),
+                        .background => self.terminal.colors.background.reset(),
+                        .cursor => self.terminal.colors.cursor.reset(),
+                        else => continue,
+                    },
+                    .special => continue,
+                },
+                .reset_palette => self.terminal.colors.palette.resetAll(),
+                .query, .reset_special => continue,
+            }
+            self.terminal.flags.dirty.palette = true;
+        }
+    }
+
+    fn kittyColorOperation(self: *ResponseHandler, value: anytype) !void {
+        for (value.list.items) |item| {
+            switch (item) {
+                .set => |set| switch (set.key) {
+                    .palette => |index| self.terminal.colors.palette.set(index, set.color),
+                    .special => |special| switch (special) {
+                        .foreground => self.terminal.colors.foreground.set(set.color),
+                        .background => self.terminal.colors.background.set(set.color),
+                        .cursor => self.terminal.colors.cursor.set(set.color),
+                        else => continue,
+                    },
+                },
+                .reset => |key| switch (key) {
+                    .palette => |index| self.terminal.colors.palette.reset(index),
+                    .special => |special| switch (special) {
+                        .foreground => self.terminal.colors.foreground.reset(),
+                        .background => self.terminal.colors.background.reset(),
+                        .cursor => self.terminal.colors.cursor.reset(),
+                        else => continue,
+                    },
+                },
+                .query => continue,
+            }
+            self.terminal.flags.dirty.palette = true;
+        }
+    }
+};
+
+/// The stream type using our response handler
+const ResponseStream = stream.Stream(ResponseHandler);
+
+/// Wrapper struct that owns the Terminal, stream, and RenderState.
+const TerminalWrapper = struct {
+    alloc: Allocator,
+    terminal: Terminal,
+    stream: ResponseStream,
+    render_state: RenderState,
+    cursor_defaults: CursorDefaults,
+    /// Response buffer for DSR and other query responses
+    response_buffer: std.ArrayList(u8),
+    /// Bounded parser storage used only by OSC families that require allocation.
+    osc_storage: [max_event_bytes]u8,
+    osc_allocator: std.heap.FixedBufferAllocator,
+    /// Ordered host-facing events and semantic row provenance.
+    events: EventQueue,
+    provenance: ProvenanceRegistry,
+    retained_searches: RetainedSearchRegistry,
+    retained_ranges: RetainedRangeRegistry,
+    /// Incremented for every parsed synchronized-output enable action.
+    synchronized_output_generation: u32 = 0,
+    /// Incremented once after each non-empty write that touches primary, so
+    /// alternate-only writes remain distinguishable.
+    primary_screen_generation: u32 = 0,
+    /// Incremented once after each non-empty write that touches alternate, so
+    /// primary-only writes remain distinguishable.
+    alternate_screen_generation: u32 = 0,
+    /// Screens reached while parsing the current write call.
+    write_screen_mask: u8 = 0,
+    /// Track alternate screen state to detect screen switches
+    last_screen_is_alternate: bool = false,
+};
+
+/// C-compatible cell structure (16 bytes)
+pub const GhosttyCell = extern struct {
+    codepoint: u32,
+    fg_r: u8,
+    fg_g: u8,
+    fg_b: u8,
+    bg_r: u8,
+    bg_g: u8,
+    bg_b: u8,
+    flags: u8,
+    width: u8,
+    hyperlink_id: u16,
+    grapheme_len: u8 = 0, // Number of extra codepoints beyond first
+    _pad: u8 = 0,
+};
+
+/// Dirty state
+pub const GhosttyDirty = enum(u8) {
+    none = 0,
+    partial = 1,
+    full = 2,
+};
+
+/// C-compatible terminal configuration
+pub const GhosttyTerminalConfig = extern struct {
+    scrollback_limit: u32,
+    color_mask: u32,
+    fg_color: u32,
+    bg_color: u32,
+    cursor_color: u32,
+    palette: [16]u32,
+    cursor_style: u8,
+    cursor_blink: u8,
+    _cursor_reserved: u16,
+};
+
+pub const GhosttyColorConfig = extern struct {
+    mask: u32,
+    fg_color: u32,
+    bg_color: u32,
+    cursor_color: u32,
+    palette: [16]u32,
+};
+
+fn rgbFromInt(value: u32) color.RGB {
+    return .{
+        .r = @truncate((value >> 16) & 0xFF),
+        .g = @truncate((value >> 8) & 0xFF),
+        .b = @truncate(value & 0xFF),
+    };
+}
+
+fn paletteConfigured(mask: u32, index: usize) bool {
+    return mask & (@as(u32, 1) << @intCast(palette_configured_shift + index)) != 0;
+}
+
+/// Update configured base colors while preserving application overrides.
+fn applyColorConfig(colors: *Terminal.Colors, config: *const GhosttyColorConfig) void {
+    if (config.mask & foreground_configured != 0) {
+        colors.foreground.changeDefault(rgbFromInt(config.fg_color));
+    }
+    if (config.mask & background_configured != 0) {
+        colors.background.changeDefault(rgbFromInt(config.bg_color));
+    }
+    if (config.mask & cursor_configured != 0) {
+        colors.cursor.changeDefault(rgbFromInt(config.cursor_color));
+    }
+
+    var base_palette = colors.palette.original;
+    var palette_changed = false;
+    for (config.palette, 0..) |palette_value, index| {
+        if (!paletteConfigured(config.mask, index)) continue;
+        base_palette[index] = rgbFromInt(palette_value);
+        palette_changed = true;
+    }
+    if (palette_changed) colors.palette.changeDefault(base_palette);
+}
+
+// ============================================================================
+// Lifecycle
+// ============================================================================
+
+pub fn new(cols: c_int, rows: c_int) callconv(.c) ?*anyopaque {
+    return newWithConfig(cols, rows, null);
+}
+
+pub fn newWithConfig(
+    cols: c_int,
+    rows: c_int,
+    config_: ?*const GhosttyTerminalConfig,
+) callconv(.c) ?*anyopaque {
+    const alloc = if (builtin.target.cpu.arch.isWasm())
+        std.heap.wasm_allocator
+    else
+        std.heap.c_allocator;
+
+    const wrapper = alloc.create(TerminalWrapper) catch return null;
+
+    const cursor_defaults = if (config_) |cfg|
+        CursorDefaults.decode(cfg.cursor_style, cfg.cursor_blink) orelse {
+            alloc.destroy(wrapper);
+            return null;
+        }
+    else
+        CursorDefaults{};
+
+    // Parse config or use defaults
+    const scrollback_limit: usize = if (config_) |cfg|
+        if (cfg.scrollback_limit == 0) std.math.maxInt(usize) else cfg.scrollback_limit
+    else
+        10_000;
+
+    // Setup configured terminal colors without treating them as application overrides.
+    var colors = Terminal.Colors.default;
+    if (config_) |cfg| {
+        const color_config: GhosttyColorConfig = .{
+            .mask = cfg.color_mask,
+            .fg_color = cfg.fg_color,
+            .bg_color = cfg.bg_color,
+            .cursor_color = cfg.cursor_color,
+            .palette = cfg.palette,
+        };
+        applyColorConfig(&colors, &color_config);
+    }
+
+    var default_modes: modespkg.ModePacked = .{};
+    default_modes.cursor_blinking = cursor_defaults.blink.initial();
+    wrapper.terminal = Terminal.init(alloc, .{
+        .cols = @intCast(cols),
+        .rows = @intCast(rows),
+        .max_scrollback = scrollback_limit,
+        .colors = colors,
+        .default_modes = default_modes,
+    }) catch {
+        alloc.destroy(wrapper);
+        return null;
+    };
+
+    wrapper.alloc = alloc;
+    wrapper.response_buffer = .{};
+    wrapper.events = .{};
+    wrapper.provenance = .{};
+    wrapper.retained_searches = .{};
+    wrapper.retained_ranges = .{};
+    wrapper.cursor_defaults = cursor_defaults;
+    wrapper.synchronized_output_generation = 0;
+    wrapper.primary_screen_generation = 0;
+    wrapper.alternate_screen_generation = 0;
+    wrapper.write_screen_mask = 0;
+    wrapper.render_state = RenderState.empty;
+    wrapper.last_screen_is_alternate = false;
+    wrapper.osc_allocator = std.heap.FixedBufferAllocator.init(&wrapper.osc_storage);
+    wrapper.cursor_defaults.setInitial(&wrapper.terminal);
+
+    // The parser allocator is intentionally bounded because PTY output is
+    // untrusted. Oversized allocating OSC sequences become invalid and are
+    // discarded by Ghostty's parser.
+    const handler = ResponseHandler.init(
+        alloc,
+        &wrapper.terminal,
+        &wrapper.response_buffer,
+        &wrapper.events,
+        &wrapper.provenance,
+        &wrapper.retained_ranges,
+        &wrapper.cursor_defaults,
+        &wrapper.synchronized_output_generation,
+        &wrapper.write_screen_mask,
+    );
+    wrapper.stream = ResponseStream.initAlloc(wrapper.osc_allocator.allocator(), handler);
+
+    // NOTE: linefeed mode must be FALSE to match native terminal behavior
+    // When true, LF does automatic CR which breaks apps like nvim
+    wrapper.terminal.modes.set(.linefeed, false);
+
+    // Enable grapheme clustering (mode 2027) by default for proper Unicode support.
+    // This makes Hindi, Arabic, emoji sequences, etc. render correctly by treating
+    // multi-codepoint grapheme clusters as single visual units.
+    wrapper.terminal.modes.set(.grapheme_cluster, true);
+
+    return @ptrCast(wrapper);
+}
+
+pub fn free(ptr: ?*anyopaque) callconv(.c) void {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return));
+    const alloc = wrapper.alloc;
+    wrapper.stream.deinit();
+    wrapper.response_buffer.deinit(alloc);
+    wrapper.events.deinit(alloc);
+    wrapper.retained_ranges.deinit(&wrapper.terminal);
+    wrapper.provenance.clear(&wrapper.terminal);
+    wrapper.retained_searches.deinit(alloc);
+    wrapper.render_state.deinit(alloc);
+    wrapper.terminal.deinit(alloc);
+    alloc.destroy(wrapper);
+}
+
+pub fn resize(ptr: ?*anyopaque, cols: c_int, rows: c_int) callconv(.c) void {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return));
+    wrapper.retained_ranges.clear(&wrapper.terminal);
+    wrapper.retained_searches.clear(wrapper.alloc);
+    wrapper.provenance.clear(&wrapper.terminal);
+    wrapper.terminal.resize(wrapper.alloc, @intCast(cols), @intCast(rows)) catch return;
+    // Match native Termio: resize is allowed to end synchronization so the
+    // new geometry cannot remain hidden behind an abandoned update.
+    wrapper.terminal.modes.set(.synchronized_output, false);
+}
+
+/// Change configured base colors without disturbing terminal contents or
+/// application-owned effective overrides.
+pub fn setColorConfig(
+    ptr: ?*anyopaque,
+    config: ?*const GhosttyColorConfig,
+) callconv(.c) bool {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return false));
+    applyColorConfig(&wrapper.terminal.colors, config orelse return false);
+    wrapper.terminal.flags.dirty.palette = true;
+    return true;
+}
+
+/// Change configured cursor defaults without replacing terminal or parser state.
+pub fn setCursorConfig(
+    ptr: ?*anyopaque,
+    style_raw: u8,
+    blink_raw: u8,
+) callconv(.c) bool {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return false));
+    const style = CursorStyleConfig.decode(style_raw) orelse return false;
+    const blink = CursorBlinkConfig.decode(blink_raw) orelse return false;
+    wrapper.cursor_defaults.update(&wrapper.terminal, style, blink);
+    return true;
+}
+
+pub fn write(ptr: ?*anyopaque, data: [*]const u8, len: usize) callconv(.c) void {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return));
+    if (len == 0) return;
+    wrapper.write_screen_mask = if (wrapper.terminal.screens.active_key == .primary)
+        primary_screen_touched
+    else
+        alternate_screen_touched;
+    defer {
+        const touched = wrapper.write_screen_mask;
+        wrapper.write_screen_mask = 0;
+        if (touched & primary_screen_touched != 0) {
+            wrapper.primary_screen_generation +%= 1;
+            if (wrapper.primary_screen_generation == 0) wrapper.primary_screen_generation = 1;
+            wrapper.retained_searches.clear(wrapper.alloc);
+            wrapper.retained_ranges.invalidateScreen(&wrapper.terminal, .primary);
+        }
+        if (touched & alternate_screen_touched != 0) {
+            wrapper.alternate_screen_generation +%= 1;
+            if (wrapper.alternate_screen_generation == 0) wrapper.alternate_screen_generation = 1;
+            wrapper.retained_ranges.invalidateScreen(&wrapper.terminal, .alternate);
+        }
+    }
+    wrapper.stream.nextSlice(data[0..len]) catch return;
+}
+
+// ============================================================================
+// Retained normal-buffer search API
+// ============================================================================
+
+pub fn retainedSearchCreate(
+    ptr: ?*anyopaque,
+    query: [*]const u8,
+    query_len: usize,
+    case_sensitive: bool,
+) callconv(.c) u32 {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return 0));
+    return wrapper.retained_searches.create(
+        wrapper.alloc,
+        &wrapper.terminal,
+        query[0..query_len],
+        case_sensitive,
+    ) orelse 0;
+}
+
+/// Return 0 while pending, 1 when complete, or -1 on invalid state/error.
+pub fn retainedSearchStep(ptr: ?*anyopaque, search_id: u32) callconv(.c) c_int {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return -1));
+    return wrapper.retained_searches.step(wrapper.alloc, search_id);
+}
+
+pub fn retainedSearchCancel(ptr: ?*anyopaque, search_id: u32) callconv(.c) void {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return));
+    wrapper.retained_searches.remove(wrapper.alloc, search_id);
+}
+
+pub fn retainedSearchMatchCount(ptr: ?*anyopaque, search_id: u32) callconv(.c) c_int {
+    const wrapper: *const TerminalWrapper = @ptrCast(@alignCast(ptr orelse return -1));
+    const count = wrapper.retained_searches.matchCount(search_id) orelse return -1;
+    return std.math.cast(c_int, count) orelse -1;
+}
+
+/// Write inclusive start/end row and column.
+pub fn retainedSearchMatchRange(
+    ptr: ?*anyopaque,
+    search_id: u32,
+    match_index: u32,
+    out: [*]u32,
+    out_len: usize,
+) callconv(.c) c_int {
+    if (out_len < 4) return -1;
+    const wrapper: *const TerminalWrapper = @ptrCast(@alignCast(ptr orelse return -1));
+    const resolved = wrapper.retained_searches.validatedPins(search_id, match_index) orelse return -1;
+    out[0] = resolved.start_row;
+    out[1] = resolved.start.x;
+    out[2] = resolved.end_row;
+    out[3] = resolved.end.x;
+    return 4;
+}
+
+/// Return the required byte length when `out_len` is zero, otherwise copy the
+/// exact plain UTF-8 text for the inclusive live range.
+pub fn retainedSearchMatchText(
+    ptr: ?*anyopaque,
+    search_id: u32,
+    match_index: u32,
+    out: ?[*]u8,
+    out_len: usize,
+) callconv(.c) c_int {
+    const wrapper: *const TerminalWrapper = @ptrCast(@alignCast(ptr orelse return -1));
+    const resolved = wrapper.retained_searches.validatedPins(search_id, match_index) orelse return -1;
+
+    const text = resolved.screen.selectionString(wrapper.alloc, .{
+        .sel = Selection.init(resolved.start, resolved.end, false),
+        .trim = false,
+    }) catch return -1;
+    defer wrapper.alloc.free(text);
+    const len = std.math.cast(c_int, text.len) orelse return -1;
+    if (out_len == 0) return len;
+    const dest = out orelse return -1;
+    if (out_len < text.len) return -1;
+    @memcpy(dest[0..text.len], text);
+    return len;
+}
+
+/// Monotonic-with-wrap generation for writes that may affect primary cells.
+pub fn getPrimaryScreenGeneration(ptr: ?*anyopaque) callconv(.c) u32 {

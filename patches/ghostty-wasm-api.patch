+/// Resolve a semantic provenance token to its current retained row.
+/// Returns -1 when the screen, row, token, or owning terminal state expired.
+pub fn resolveEventProvenance(
+    ptr: ?*anyopaque,
+    provenance_id: u32,
+    alternate: bool,
+) callconv(.c) c_int {
+    const wrapper: *const TerminalWrapper = @ptrCast(@alignCast(ptr orelse return -1));
+    const screen: ScreenSet.Key = if (alternate) .alternate else .primary;
+    const row = wrapper.provenance.resolve(&wrapper.terminal, provenance_id, screen) orelse return -1;
+    return std.math.cast(c_int, row) orelse -1;
+}
+
+/// Resolve retained row and column for a semantic provenance token.
+pub fn resolveEventBoundary(
+    ptr: ?*anyopaque,
+    provenance_id: u32,
+    alternate: bool,
+    out: [*]u32,
+    out_len: usize,
+) callconv(.c) c_int {
+    if (out_len < 2) return -1;
+    const wrapper: *const TerminalWrapper = @ptrCast(@alignCast(ptr orelse return -1));
+    const screen_key: ScreenSet.Key = if (alternate) .alternate else .primary;
+    const boundary = wrapper.provenance.resolvePin(
+        &wrapper.terminal,
+        provenance_id,
+        screen_key,
+    ) orelse return -1;
+    const screen = wrapper.terminal.screens.get(screen_key) orelse return -1;
+    out[0] = ProvenanceRegistry.absoluteRow(&screen.pages, boundary.pin) orelse return -1;
+    out[1] = if (boundary.after_cell) boundary.pin.node.data.size.cols else boundary.pin.x;
+    return 2;
+}

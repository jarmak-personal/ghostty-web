+//! C API wrapper for Terminal
+//!
+//! This provides a minimal, high-performance interface to Ghostty's Terminal
+//! for WASM export. The key optimization is using RenderState which provides
+//! a pre-computed snapshot of all render data in a single update call.
+//!
+//! API Design:
+//! - Lifecycle: new, free, resize, write
+//! - Rendering: render_state_update, render_state_get_viewport, etc.
+//!
+//! The RenderState approach means:
+//! - ONE call to update all state (render_state_update)
+//! - ONE call to get all cells (render_state_get_viewport)
+//! - No per-row or per-cell WASM boundary crossings!
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const builtin = @import("builtin");
+
+const Terminal = @import("../Terminal.zig");
+const stream = @import("../stream.zig");
+const Action = stream.Action;
+const ansi = @import("../ansi.zig");
+const render = @import("../render.zig");
+const RenderState = render.RenderState;
+const color = @import("../color.zig");
+const modespkg = @import("../modes.zig");
+const point = @import("../point.zig");
+const Style = @import("../style.zig").Style;
+const device_status = @import("../device_status.zig");
+const osc_color = @import("../osc/parsers/color.zig");
+const PageList = @import("../PageList.zig");
+const Screen = @import("../Screen.zig");
+const ScreenSet = @import("../ScreenSet.zig");
+const Selection = @import("../Selection.zig");
+const pagepkg = @import("../page.zig");
+const ScreenSearch = @import("../search/screen.zig").ScreenSearch;
+const PageFormatter = @import("../formatter.zig").PageFormatter;
+const tripwire = @import("../../tripwire.zig");
+
+const log = std.log.scoped(.terminal_c);
+
+/// Maximum bytes retained for either an in-progress allocating OSC payload or
+/// unread structured event records. This keeps untrusted PTY output bounded.
+const max_event_bytes = 64 * 1024;
+const max_search_query_bytes = 64 * 1024;
+const max_retained_range_bytes = 4 * 1024 * 1024;
+const primary_screen_touched: u8 = 1;
+const alternate_screen_touched: u8 = 2;
+const foreground_configured: u32 = 1 << 0;
+const background_configured: u32 = 1 << 1;
+const cursor_configured: u32 = 1 << 2;
+const palette_configured_shift = 8;
+
+const CursorStyleConfig = enum(u8) {
+    block = 0,
+    block_hollow = 1,
+    bar = 2,
+    underline = 3,
+
+    fn decode(raw: u8) ?CursorStyleConfig {
+        return std.meta.intToEnum(CursorStyleConfig, raw) catch null;
+    }
+
+    fn terminalStyle(self: CursorStyleConfig) Screen.CursorStyle {
+        return switch (self) {
+            .block => .block,
+            .block_hollow => .block_hollow,
+            .bar => .bar,
+            .underline => .underline,
+        };
+    }
+};
+
+const CursorBlinkConfig = enum(u8) {
+    terminal = 0,
+    blinking = 1,
+    steady = 2,
+
+    fn decode(raw: u8) ?CursorBlinkConfig {
+        return std.meta.intToEnum(CursorBlinkConfig, raw) catch null;
+    }
+
+    fn initial(self: CursorBlinkConfig) bool {
+        return switch (self) {
+            .terminal, .blinking => true,
+            .steady => false,
+        };
+    }
+};
+
+/// Configured defaults and whether an application DECSCUSR currently owns the cursor.
+const CursorDefaults = struct {
+    style: CursorStyleConfig = .block,
+    blink: CursorBlinkConfig = .steady,
+    active: bool = true,
+
+    fn decode(style: u8, blink: u8) ?CursorDefaults {
+        return .{
+            .style = CursorStyleConfig.decode(style) orelse return null,
+            .blink = CursorBlinkConfig.decode(blink) orelse return null,
+        };
+    }
+
+    fn setInitial(self: *const CursorDefaults, terminal: *Terminal) void {
+        terminal.screens.active.cursor.cursor_style = self.style.terminalStyle();
+        terminal.modes.set(.cursor_blinking, self.blink.initial());
+    }
+
+    fn reset(self: *CursorDefaults, terminal: *Terminal) void {
+        self.active = true;
+        self.setInitial(terminal);
+    }
+
+    fn setApplication(
+        self: *CursorDefaults,
+        terminal: *Terminal,
+        style: Screen.CursorStyle,
+        blink: bool,
+    ) void {
+        self.active = false;
+        terminal.screens.active.cursor.cursor_style = style;
+        terminal.modes.set(.cursor_blinking, blink);
+    }
+
+    fn update(
+        self: *CursorDefaults,
+        terminal: *Terminal,
+        style: CursorStyleConfig,
+        blink: CursorBlinkConfig,
+    ) void {
+        const prior_blink = self.blink;
+        self.style = style;
+        self.blink = blink;
+        terminal.modes.default.cursor_blinking = blink.initial();
+        if (!self.active) return;
+
+        terminal.screens.active.cursor.cursor_style = style.terminalStyle();
+        // A same-policy terminal-controlled update preserves the live DEC mode.
+        if (prior_blink != blink or blink != .terminal) {
+            terminal.modes.set(.cursor_blinking, blink.initial());
+        }
+    }
+};
+
+/// Versioned wire tags consumed by the TypeScript wrapper. The wire format is
+/// internal to this compatibility ABI; public consumers receive typed records.
+const EventTag = enum(u8) {
+    title = 1,
+    working_directory = 2,
+    bell = 3,
+    notification = 4,
+    progress = 5,
+    semantic = 6,
+    palette = 7,
+    clipboard = 8,
+};
+
+/// Fixed little-endian WASM event header followed by data_a then data_b.
+const EventHeader = extern struct {
+    version: u8 = 1,
+    tag: EventTag,
+    action: u8 = 0,
+    flags: u8 = 0,
+    row: u32 = 0,
+    provenance_id: u32 = 0,
+    reserved: u32 = 0,
+    value: i32 = 0,
+    target: i32 = 0,
+    color_value: u32 = 0,
+    data_a_len: u32 = 0,
+    data_b_len: u32 = 0,
+};
+
+comptime {
+    std.debug.assert(@sizeOf(EventHeader) == 36);
+}
+
+const EventQueue = struct {
+    buffer: std.ArrayList(u8) = .{},
+    read_offset: usize = 0,
+
+    fn deinit(self: *EventQueue, alloc: Allocator) void {
+        self.buffer.deinit(alloc);
+        self.* = .{};
+    }
+
+    fn clearRetainingCapacity(self: *EventQueue) void {
+        self.buffer.clearRetainingCapacity();
+        self.read_offset = 0;
+    }
+
+    fn pendingBytes(self: *const EventQueue) usize {
+        return self.buffer.items.len - self.read_offset;
+    }
+
+    fn compact(self: *EventQueue) void {
+        if (self.read_offset == 0) return;
+        const remaining = self.pendingBytes();
+        std.mem.copyForwards(
+            u8,
+            self.buffer.items[0..remaining],
+            self.buffer.items[self.read_offset..],
+        );
+        self.buffer.items.len = remaining;
+        self.read_offset = 0;
+    }
+
+    fn append(
+        self: *EventQueue,
+        alloc: Allocator,
+        header_: EventHeader,
+        data_a: []const u8,
+        data_b: []const u8,
+    ) void {
+        const record_len = @sizeOf(EventHeader) + data_a.len + data_b.len;
+        if (record_len > max_event_bytes) return;
+
+        if (self.pendingBytes() + record_len > max_event_bytes and self.read_offset > 0) {
+            self.compact();
+        }
+        if (self.pendingBytes() + record_len > max_event_bytes) return;
+
+        var header = header_;
+        header.data_a_len = @intCast(data_a.len);
+        header.data_b_len = @intCast(data_b.len);
+        self.buffer.ensureUnusedCapacity(alloc, record_len) catch return;
+        self.buffer.appendSliceAssumeCapacity(std.mem.asBytes(&header));
+        self.buffer.appendSliceAssumeCapacity(data_a);
+        self.buffer.appendSliceAssumeCapacity(data_b);
+    }
+
+    fn peekSize(self: *const EventQueue) usize {
+        if (self.pendingBytes() < @sizeOf(EventHeader)) return 0;
+        const header: *align(1) const EventHeader = @ptrCast(
+            self.buffer.items[self.read_offset..][0..@sizeOf(EventHeader)].ptr,
+        );
+        const size = @sizeOf(EventHeader) + header.data_a_len + header.data_b_len;
+        if (size > self.pendingBytes() or size > max_event_bytes) return 0;
+        return size;
+    }
+
+    fn read(self: *EventQueue, out: [*]u8, out_len: usize) c_int {
+        const size = self.peekSize();
+        if (size == 0) return 0;
+        if (out_len < size) return -1;
+        @memcpy(out[0..size], self.buffer.items[self.read_offset..][0..size]);
+        self.read_offset += size;
+        if (self.read_offset == self.buffer.items.len) self.clearRetainingCapacity();
+        return @intCast(size);
+    }
+};
+
+const max_provenance_entries = 256;
+
+const ProvenanceRegistry = struct {
+    const Entry = struct {
+        id: u32,
+        screen: ScreenSet.Key,
+        pin: *PageList.Pin,
+        row: *pagepkg.Row,
+        serial: u64,
+        after_cell: bool,
+    };
+
+    entries: [max_provenance_entries]?Entry = [_]?Entry{null} ** max_provenance_entries,
+    next_slot: usize = 0,
+    next_id: u32 = 1,
+
+    fn clear(self: *ProvenanceRegistry, terminal: *Terminal) void {
+        for (&self.entries) |*entry| {
+            if (entry.*) |existing| {
+                if (terminal.screens.get(existing.screen)) |screen| {
+                    screen.pages.untrackPin(existing.pin);
+                }
+                entry.* = null;
+            }
+        }
+        self.next_slot = 0;
+    }
+
+    const Boundary = struct {
+        id: u32,
+        screen: ScreenSet.Key,
+        row: u32,
+        column: u32,
+    };
+
+    fn register(self: *ProvenanceRegistry, terminal: *Terminal) ?Boundary {
+        const screen_key = terminal.screens.active_key;
+        const pages = &terminal.screens.active.pages;
+        const after_cell = terminal.screens.active.cursor.pending_wrap;
+        const tracked = pages.trackPin(terminal.screens.active.cursor.page_pin.*) catch return null;
+
+        const slot = self.next_slot;
+        self.next_slot = (self.next_slot + 1) % max_provenance_entries;
+        if (self.entries[slot]) |existing| {
+            if (terminal.screens.get(existing.screen)) |screen| {
+                screen.pages.untrackPin(existing.pin);
+            }
+        }
+
+        const id = self.next_id;
+        self.next_id +%= 1;
+        if (self.next_id == 0) self.next_id = 1;
+        self.entries[slot] = .{
+            .id = id,
+            .screen = screen_key,
+            .pin = tracked,
+            .row = tracked.rowAndCell().row,
+            .serial = tracked.node.serial,
+            .after_cell = after_cell,
+        };
+
+        return .{
+            .id = id,
+            .screen = screen_key,
+            .row = @intCast(pages.total_rows - pages.rows + terminal.screens.active.cursor.y),
+            .column = if (after_cell) tracked.node.data.size.cols else tracked.x,
+        };
+    }
+
+    fn resolve(self: *const ProvenanceRegistry, terminal: *const Terminal, id: u32, screen_key: ScreenSet.Key) ?u32 {
+        const existing = self.resolvePin(terminal, id, screen_key) orelse return null;
+        const screen = terminal.screens.get(screen_key) orelse return null;
+        return absoluteRow(&screen.pages, existing.pin);
+    }
+
+    fn resolvePin(
+        self: *const ProvenanceRegistry,
+        terminal: *const Terminal,
+        id: u32,
+        screen_key: ScreenSet.Key,
+    ) ?Entry {
+        for (self.entries) |entry| {
+            const existing = entry orelse continue;
+            if (existing.id != id or existing.screen != screen_key or existing.pin.garbage) continue;
+            _ = terminal.screens.get(screen_key) orelse return null;
+            if (existing.pin.node.serial != existing.serial or
+                existing.pin.y >= existing.pin.node.data.size.rows or
+                existing.pin.x >= existing.pin.node.data.size.cols) return null;
+            if (existing.pin.rowAndCell().row != existing.row) return null;
+            return existing;
+        }
+        return null;
+    }
+
+    fn absoluteRow(pages: *const PageList, pin: *const PageList.Pin) ?u32 {
+        var row: usize = 0;
+        var node = pages.pages.first;
+        while (node) |current| : (node = current.next) {
+            if (current == pin.node) {
+                if (pin.y >= current.data.size.rows) return null;
+                return std.math.cast(u32, row + pin.y);
+            }
+            row += current.data.size.rows;
+        }
+        return null;
+    }
+};
+
+/// Exact retained text ranges own tracked copies of their boundary pins and
+/// advance formatting by at most one Ghostty page per step.
+const RetainedRangeRegistry = struct {
+    const Entry = struct {
+        id: u32,
+        screen: ScreenSet.Key,
+        start: *PageList.Pin,
+        end: *PageList.Pin,
+        start_row: *pagepkg.Row,
+        end_row: *pagepkg.Row,
+        start_serial: u64,
+        end_serial: u64,
+        start_after_cell: bool,
+        end_after_cell: bool,
+        format_start: PageList.Pin,
+        format_start_serial: u64,
+        next_node: ?*PageList.List.Node,
+        next_serial: u64,
+        trailing_state: ?PageFormatter.TrailingState = null,
+        output: std.Io.Writer.Allocating,
+        prefix_newline: bool = false,
+        no_cells: bool = false,
+        complete: bool = false,
+        active: bool = true,
+
+        fn invalidate(self: *Entry, terminal: *Terminal) void {
+            if (!self.active) return;
+            if (terminal.screens.get(self.screen)) |screen| {
+                screen.pages.untrackPin(self.start);
+                screen.pages.untrackPin(self.end);
+            }
+            self.output.deinit();
+            self.active = false;
+        }
+
+        fn deinit(self: *Entry, terminal: *Terminal) void {
+            self.invalidate(terminal);
+        }
+    };
+
+    entry: ?Entry = null,
+    next_id: u32 = 1,
+
+    fn deinit(self: *RetainedRangeRegistry, terminal: *Terminal) void {
+        if (self.entry) |*entry| entry.deinit(terminal);
+        self.* = .{};
+    }
+
+    fn clear(self: *RetainedRangeRegistry, terminal: *Terminal) void {
+        if (self.entry) |*entry| entry.deinit(terminal);
+        self.entry = null;
+    }
+
+    fn invalidateScreen(self: *RetainedRangeRegistry, terminal: *Terminal, key: ScreenSet.Key) void {
+        const entry = if (self.entry) |*entry| entry else return;
+        if (entry.screen == key) entry.invalidate(terminal);
+    }
